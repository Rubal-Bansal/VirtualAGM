PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Public IP/hostname that shareholders' browsers can reach for WebRTC media.
# For local development, 127.0.0.1 is fine.
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
MEDIASOUP_RTC_MIN_PORT=40000
MEDIASOUP_RTC_MAX_PORT=40100

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/virtual_agm

# Secret used to sign login tokens (JWT). Use a long random value.
JWT_SECRET=change-me
